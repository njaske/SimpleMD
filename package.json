{
  "name": "simplemd",
  "version": "1.0.3",
  "description": "A fast, private desktop Markdown reader for AI-generated docs, with KaTeX math and Mermaid diagrams.",
  "keywords": [
    "markdown",
    "markdown-reader",
    "markdown-viewer",
    "katex",
    "mermaid",
    "electron",
    "desktop",
    "windows"
  ],
  "homepage": "https://njaske.github.io/SimpleMD/",
  "bugs": {
    "url": "https://github.com/njaske/SimpleMD/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njaske/SimpleMD.git"
  },
  "license": "MIT",
  "author": "njaske",
  "engines": {
    "node": ">=22"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "dompurify": "^3.1.7",
    "highlight.js": "^11.10.0",
    "katex": "^0.16.47",
    "marked": "^14.1.3",
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
