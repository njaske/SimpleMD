{
  "name": "simplemd",
  "version": "1.0.3",
  "description": "A fast, private desktop Markdown reader for AI-generated docs, with KaTeX math and Mermaid diagrams.",
  "keywords": [
    "markdown",
    "markdown-reader",
    "markdown-viewer",
    "katex",
    "mermaid",
    "electron",
    "desktop",
    "windows"
  ],
  "homepage": "https://njaske.github.io/SimpleMD/",
  "bugs": {
    "url": "https://github.com/njaske/SimpleMD/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njaske/SimpleMD.git"
  },
  "license": "MIT",
  "author": "njaske",
  "engines": {
    "node": ">=22.12"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "dompurify": "^3.1.7",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "marked-footnote": "^1.4.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.3",
    "vite": "^8.3.4"
  }
}
